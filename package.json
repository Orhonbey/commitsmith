{
  "name": "commitsmith",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.3.0",
  "publisher": "commitsmith",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "AI"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%untrustedWorkspaces%"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commitsmith",
          "title": "%viewContainer.title%",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "commitsmith": [
        {
          "type": "webview",
          "id": "commitsmith.panel",
          "name": "%view.panel.name%",
          "initialSize": 3
        },
        {
          "id": "commitsmith.changes",
          "name": "%view.changes.name%",
          "initialSize": 6
        },
        {
          "id": "commitsmith.recent",
          "name": "%view.recent.name%",
          "visibility": "collapsed",
          "initialSize": 1
        }
      ]
    },
    "commands": [
      {
        "command": "commitsmith.writeMessage",
        "title": "%cmd.writeMessage%",
        "category": "%category%",
        "icon": "$(sparkle)"
      },
      {
        "command": "commitsmith.writeAndCommit",
        "title": "%cmd.writeAndCommit%",
        "category": "%category%",
        "icon": "$(check-all)"
      },
      {
        "command": "commitsmith.smartSplit",
        "title": "%cmd.smartSplit%",
        "category": "%category%",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "commitsmith.push",
        "title": "%cmd.push%",
        "category": "%category%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "commitsmith.pickModel",
        "title": "%cmd.pickModel%",
        "category": "%category%"
      },
      {
        "command": "commitsmith.refreshChanges",
        "title": "%cmd.refresh%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "commitsmith.stage",
        "title": "%cmd.stage%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "commitsmith.unstage",
        "title": "%cmd.unstage%",
        "category": "%category%",
        "icon": "$(remove)"
      },
      {
        "command": "commitsmith.discard",
        "title": "%cmd.discard%",
        "category": "%category%",
        "icon": "$(discard)"
      },
      {
        "command": "commitsmith.stageAll",
        "title": "%cmd.stageAll%",
        "category": "%category%",
        "icon": "$(add)"
      },
      {
        "command": "commitsmith.unstageAll",
        "title": "%cmd.unstageAll%",
        "category": "%category%",
        "icon": "$(remove)"
      },
      {
        "command": "commitsmith.discardAll",
        "title": "%cmd.discardAll%",
        "category": "%category%",
        "icon": "$(discard)"
      },
      {
        "command": "commitsmith.openFile",
        "title": "%cmd.openFile%",
        "category": "%category%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "commitsmith.copyPath",
        "title": "%cmd.copyPath%",
        "category": "%category%"
      },
      {
        "command": "commitsmith.openChange",
        "title": "%cmd.openChange%",
        "category": "%category%"
      },
      {
        "command": "commitsmith.copySha",
        "title": "%cmd.copySha%",
        "category": "%category%"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "commitsmith.writeMessage",
          "when": "scmProvider == git",
          "group": "navigation@1"
        },
        {
          "command": "commitsmith.writeAndCommit",
          "when": "scmProvider == git",
          "group": "navigation@2"
        },
        {
          "command": "commitsmith.smartSplit",
          "when": "scmProvider == git",
          "group": "navigation@3"
        },
        {
          "command": "commitsmith.push",
          "when": "scmProvider == git",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "commitsmith.writeMessage",
          "when": "gitOpenRepositoryCount != 0"
        },
        {
          "command": "commitsmith.writeAndCommit",
          "when": "gitOpenRepositoryCount != 0"
        },
        {
          "command": "commitsmith.smartSplit",
          "when": "gitOpenRepositoryCount != 0"
        },
        {
          "command": "commitsmith.push",
          "when": "gitOpenRepositoryCount != 0"
        },
        {
          "command": "commitsmith.pickModel",
          "when": "gitOpenRepositoryCount != 0"
        },
        {
          "command": "commitsmith.refreshChanges",
          "when": "false"
        },
        {
          "command": "commitsmith.stage",
          "when": "false"
        },
        {
          "command": "commitsmith.unstage",
          "when": "false"
        },
        {
          "command": "commitsmith.discard",
          "when": "false"
        },
        {
          "command": "commitsmith.stageAll",
          "when": "false"
        },
        {
          "command": "commitsmith.unstageAll",
          "when": "false"
        },
        {
          "command": "commitsmith.discardAll",
          "when": "false"
        },
        {
          "command": "commitsmith.openFile",
          "when": "false"
        },
        {
          "command": "commitsmith.copyPath",
          "when": "false"
        },
        {
          "command": "commitsmith.openChange",
          "when": "false"
        },
        {
          "command": "commitsmith.copySha",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "commitsmith.refreshChanges",
          "when": "view == commitsmith.changes",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "commitsmith.openFile",
          "when": "view == commitsmith.changes && viewItem == file.merge",
          "group": "inline@1"
        },
        {
          "command": "commitsmith.stage",
          "when": "view == commitsmith.changes && viewItem == file.merge",
          "group": "inline@3"
        },
        {
          "command": "commitsmith.stage",
          "when": "view == commitsmith.changes && viewItem == file.merge",
          "group": "1_modification@1"
        },
        {
          "command": "commitsmith.openFile",
          "when": "view == commitsmith.changes && viewItem == file.merge",
          "group": "navigation@1"
        },
        {
          "command": "commitsmith.copyPath",
          "when": "view == commitsmith.changes && viewItem == file.merge",
          "group": "2_copy@1"
        },
        {
          "command": "commitsmith.openFile",
          "when": "view == commitsmith.changes && viewItem == file.staged",
          "group": "inline@1"
        },
        {
          "command": "commitsmith.unstage",
          "when": "view == commitsmith.changes && viewItem == file.staged",
          "group": "inline@3"
        },
        {
          "command": "commitsmith.openFile",
          "when": "view == commitsmith.changes && viewItem == file.changes",
          "group": "inline@1"
        },
        {
          "command": "commitsmith.discard",
          "when": "view == commitsmith.changes && viewItem == file.changes",
          "group": "inline@2"
        },
        {
          "command": "commitsmith.stage",
          "when": "view == commitsmith.changes && viewItem == file.changes",
          "group": "inline@3"
        },
        {
          "command": "commitsmith.openFile",
          "when": "view == commitsmith.changes && viewItem == file.new",
          "group": "inline@1"
        },
        {
          "command": "commitsmith.stage",
          "when": "view == commitsmith.changes && viewItem == file.new",
          "group": "inline@3"
        },
        {
          "command": "commitsmith.unstageAll",
          "when": "view == commitsmith.changes && viewItem == group.staged",
          "group": "inline@1"
        },
        {
          "command": "commitsmith.discardAll",
          "when": "view == commitsmith.changes && viewItem == group.changes",
          "group": "inline@1"
        },
        {
          "command": "commitsmith.stageAll",
          "when": "view == commitsmith.changes && viewItem == group.changes",
          "group": "inline@2"
        },
        {
          "command": "commitsmith.stageAll",
          "when": "view == commitsmith.changes && viewItem == group.untracked",
          "group": "inline@1"
        },
        {
          "command": "commitsmith.unstage",
          "when": "view == commitsmith.changes && viewItem == file.staged",
          "group": "1_modification@1"
        },
        {
          "command": "commitsmith.openFile",
          "when": "view == commitsmith.changes && viewItem == file.staged",
          "group": "navigation@1"
        },
        {
          "command": "commitsmith.copyPath",
          "when": "view == commitsmith.changes && viewItem == file.staged",
          "group": "2_copy@1"
        },
        {
          "command": "commitsmith.stage",
          "when": "view == commitsmith.changes && viewItem == file.changes",
          "group": "1_modification@1"
        },
        {
          "command": "commitsmith.discard",
          "when": "view == commitsmith.changes && viewItem == file.changes",
          "group": "1_modification@2"
        },
        {
          "command": "commitsmith.openFile",
          "when": "view == commitsmith.changes && viewItem == file.changes",
          "group": "navigation@1"
        },
        {
          "command": "commitsmith.copyPath",
          "when": "view == commitsmith.changes && viewItem == file.changes",
          "group": "2_copy@1"
        },
        {
          "command": "commitsmith.stage",
          "when": "view == commitsmith.changes && viewItem == file.new",
          "group": "1_modification@1"
        },
        {
          "command": "commitsmith.openFile",
          "when": "view == commitsmith.changes && viewItem == file.new",
          "group": "navigation@1"
        },
        {
          "command": "commitsmith.copyPath",
          "when": "view == commitsmith.changes && viewItem == file.new",
          "group": "2_copy@1"
        },
        {
          "command": "commitsmith.unstageAll",
          "when": "view == commitsmith.changes && viewItem == group.staged",
          "group": "1_modification@1"
        },
        {
          "command": "commitsmith.stageAll",
          "when": "view == commitsmith.changes && viewItem == group.changes",
          "group": "1_modification@1"
        },
        {
          "command": "commitsmith.discardAll",
          "when": "view == commitsmith.changes && viewItem == group.changes",
          "group": "1_modification@2"
        },
        {
          "command": "commitsmith.stageAll",
          "when": "view == commitsmith.changes && viewItem == group.untracked",
          "group": "1_modification@1"
        }
      ]
    },
    "configuration": {
      "title": "CommitSmith",
      "properties": {
        "commitsmith.tool": {
          "type": "string",
          "enum": [
            "claude",
            "codex"
          ],
          "default": "claude",
          "description": "%config.tool%"
        },
        "commitsmith.model": {
          "type": "string",
          "default": "",
          "description": "%config.model%"
        },
        "commitsmith.messageLanguage": {
          "type": "string",
          "default": "English",
          "description": "%config.messageLanguage%"
        },
        "commitsmith.includeUntracked": {
          "type": "boolean",
          "default": false,
          "description": "%config.includeUntracked%"
        },
        "commitsmith.stripAiAttribution": {
          "type": "boolean",
          "default": true,
          "description": "%config.stripAiAttribution%"
        },
        "commitsmith.summaryOnlyExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".asset",
            ".prefab",
            ".unity",
            ".meta",
            ".mat",
            ".anim",
            ".controller",
            ".png",
            ".jpg",
            ".jpeg",
            ".psd",
            ".tga",
            ".exr",
            ".wav",
            ".mp3",
            ".ogg",
            ".fbx",
            ".ttf",
            ".otf",
            ".zip",
            ".dll"
          ],
          "description": "%config.summaryOnlyExtensions%"
        },
        "commitsmith.maxFileDiffBytes": {
          "type": "number",
          "default": 200000,
          "minimum": 1000,
          "description": "%config.maxFileDiffBytes%"
        },
        "commitsmith.maxTotalBytes": {
          "type": "number",
          "default": 400000,
          "minimum": 1000,
          "description": "%config.maxTotalBytes%"
        },
        "commitsmith.timeoutSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 10,
          "description": "%config.timeoutSeconds%"
        },
        "commitsmith.models.claude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.models.claude%"
        },
        "commitsmith.models.codex": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.models.codex%"
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "commitsmith.changes",
        "contents": "%welcome.noRepo%",
        "when": "gitOpenRepositoryCount == 0"
      },
      {
        "view": "commitsmith.changes",
        "contents": "%welcome.noChanges%",
        "when": "gitOpenRepositoryCount != 0"
      },
      {
        "view": "commitsmith.recent",
        "contents": "%welcome.recent%"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "test": "mocha --timeout 20000 --import=tsx \"test/**/*.test.ts\"",
    "package": "vsce package",
    "test:vscode": "node esbuild.mjs && node test/vscode/smoke/build.mjs && node test/vscode/smoke/dist/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/vscode": "1.95",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
